# vec_stream 凭据与配置 —— 复制为 .env 并改成强随机值,.env 已 gitignore。
# M1 加固:数据库不再用单一超级账号,按职责拆分最小权限角色;RAG API 需鉴权。

# 本地开发留空或 development。生产设 production 后会启用启动期安全防呆:
# 禁止 dev-key-default / change-me-* / 裸 Qdrant 等默认弱配置。
APP_ENV=development

# ── Postgres 超级账号(仅 owner/初始化/迁移用,业务进程不用)──
POSTGRES_USER=vec_stream
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=vec_stream

# ── 最小权限业务角色密码(由 db/init/02-security.sh 建号时注入)──
# vs_debezium: LOGIN + REPLICATION + 源表 SELECT(CDC 专用,非超级账号)
DEBEZIUM_PASSWORD=change-me-debezium
# vs_worker: doc_vectors/processed_offsets 全 DML + 源表 SELECT(反查)+ BYPASSRLS(可信写入端)
WORKER_PASSWORD=change-me-worker
# vs_rag: 仅 doc_vectors SELECT,受 RLS 约束(查询强制按 app.tenant 隔离)
RAG_PASSWORD=change-me-rag

# ── 各进程的连接串(用各自最小权限角色)──
# worker(消费 CDC 写向量 + 反查源库)
WORKER_PG_DSN=postgresql://vs_worker:change-me-worker@localhost:5433/vec_stream
# rag(只读召回,受 RLS 隔离)
RAG_PG_DSN=postgresql://vs_rag:change-me-rag@localhost:5433/vec_stream

# ── Lakehouse 旁路本地对象存储(MinIO;docker-compose.lake.yml / .paimon.yml 用)──
# 生产务必改成强随机值。Spark 侧凭据只经环境变量进 EnvironmentVariableCredentialsProvider,
# 不放进 spark-submit 命令行 / Spark UI Environment 页(批4 安全)。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ── Lakehouse 流式可靠性/背压(批4;留空=Spark 默认无界单批)──
# FAIL_ON_DATA_LOSS=true   丢 offset 即响亮失败(默认,改 false 仅在容忍数据缺口时)
# MAX_OFFSETS_PER_TRIGGER  单微批最大拉取条数,设值=背压 + 崩溃后有界恢复(如 100000)
# TRIGGER_SECONDS=10       微批触发间隔
FAIL_ON_DATA_LOSS=true
MAX_OFFSETS_PER_TRIGGER=
TRIGGER_SECONDS=10

# ── RAG API 鉴权:API key → 租户绑定(JSON)。租户从 key 推导,不信任请求体 ──
# 生产用强随机 key;一个 key 绑一个租户,实现"token 即租户"闭环。
RAG_API_KEYS={"dev-key-default":"default"}

# ── Embedding 后端(worker 写入侧 + rag 检索侧必须一致)──
# Qdrant 生产必须设置 API key;本地 qdrant/qdrant 镜像默认无鉴权,只允许绑定 127.0.0.1。
# QDRANT_API_KEY=
# 三选一:① 进程内本地模型(默认)② 独立 embed-service ③ OpenAI 兼容 embeddings
# EMBED_SERVICE_URL=http://localhost:8200   # 设了就走 embed-service(托管本地模型)
EMBED_PROVIDER=local                          # local | openai
EMBED_MODEL=BAAI/bge-small-zh-v1.5            # openai 时填如 text-embedding-3-small
EMBED_DIM=512                                 # ⚠️ 必须等于 doc_vectors.embedding 维度;换维需蓝绿重建
# EMBED_PROVIDER=openai 会把源文档发给 OpenAI-compatible embeddings 端点;需显式允许数据出境。
EMBED_EGRESS_ALLOWED=false
# EMBED_PROVIDER=openai 时(复用 OPENAI_API_KEY;base_url 可单独指,覆盖 OpenAI/TEI/Ollama/vLLM):
# EMBED_OPENAI_BASE_URL=http://localhost:8080/v1   # 如 TEI / Ollama embeddings
# worker 写 index_metadata,rag 启动校验 embedding/chunk/backend 是否与已构建索引一致。
# 旧库迁移窗口可临时关 rag 校验,正常运行建议保持 true。
INDEX_METADATA_ENABLED=true
INDEX_METADATA_CHECK=true

# ── RAG 生成层 LLM(/ask 用;/search 不需要)──
# /ask 会把召回资料发给 OpenAI-compatible 端点;生产默认必须显式允许数据出境。
LLM_EGRESS_ALLOWED=false
# 统一走 OpenAI 兼容协议(一条路):OPENAI_BASE_URL 指 agent-ctl 网关或任意兼容服务。
#   agent-ctl 网关(推荐,网关侧处理 Claude/路由/回退/成本):http://localhost:8400/v1
#   OpenAI 留空(默认 api.openai.com)/ DeepSeek https://api.deepseek.com
#   通义 https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama http://localhost:11434/v1  /  vLLM http://localhost:8000/v1
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 结构化日志(worker / rag,便于进 ELK / Loki)──
# text(默认,人类可读,本地友好)| json(每行一个 JSON:ts/level/logger/msg + extra)
LOG_FORMAT=text
LOG_LEVEL=INFO
# 提示:uvicorn 自身 access log 不受此控制;需要 JSON 化时用 uvicorn --log-config 或 --no-access-log。

# ── OpenTelemetry 分布式追踪(可选,默认关)──
# false(默认):服务零开销、不 import otel、无需装 otel extra。
# true:装全局 TracerProvider + OTLP 导出器并自动埋点 FastAPI;
#   先起 Jaeger overlay:docker compose -f docker-compose.otel.yml up -d
#   再给服务装可选 extra(embed-service):pip install '.[otel]' / uv sync --extra otel
#   Jaeger UI:http://localhost:16686(可见 rag → embed-service 跨服务串联)。
OTEL_ENABLED=false
# OTLP gRPC 接收端点。宿主机跑用 localhost;容器内跑同网络用 http://jaeger:4317。
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
